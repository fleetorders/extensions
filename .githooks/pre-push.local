#!/usr/bin/env sh
# Screen what this push publishes: branch and tag names, tag and commit messages, and the
# tracked hooks, scripts and package manifest. The checker is resolved by name from PATH;
# where it is not installed there is no check, never a failure. (published-surface stub)
GUARD=$(command -v public-surface-guard || true)
if [ -x "$GUARD" ]; then
  "$GUARD" --pre-push "$@" || exit 1
fi
# Machine-local companion checks, when this machine has any. The companion's contents never
# enter this repo — a contributor without one pushes exactly as before. It gets the push
# arguments like the checker above, but not stdin: the checker reads the ref list git feeds
# this hook, so a companion that needs the refs must derive them itself.
if [ -x local/hooks/pre-push ]; then
  local/hooks/pre-push "$@" || exit 1
elif [ -e local/hooks/pre-push ]; then
  echo "pre-push: local/hooks/pre-push exists but is not executable — skipped" >&2
fi

exit 0
