# What the published extension leaves out. vsce does not read .gitignore, so anything not
# needed at runtime is named here; `npx @vscode/vsce ls` shows what would ship.
src/**
docs/**
node_modules/**
esbuild.mjs
tsconfig.json
.gitignore
local/**
*.vsix
**/*.map
# Maintainer checks run before packaging; installed extensions never read them.
.artifact-check-allow
scripts/**
# SVG sources and the README banner; the rendered icon ships.
media/*.svg
media/claude-code-provider-switcher-logo.png
